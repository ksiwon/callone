# callone 환경변수 예시 — 복사해서 .env 로 쓰기
# 결제형 API 키는 절대 없음 (§2 하드 제약). 전부 무료 토큰/로컬 경로.

# Hugging Face 무료 토큰 (필수): pyannote / Gemma 게이트 모델 다운로드용
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AIHub 계정 (선택): 방언/저음질 통화 데이터 — 없어도 파이프라인 동작
AIHUB_ID=
AIHUB_PW=

# 데이터 루트 (모든 산출물 여기 아래에)
CALLONE_DATA_DIR=./data

# 연산 디바이스: cuda | cpu | mps
DEVICE=cuda

# 데이터 암호화 키 (§20). 32바이트 base64. 생성: python -m callone.common.crypto genkey
ENCRYPTION_KEY=

# 선택: 모델 캐시 경로
HF_HOME=./.hf_cache
